<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mcq_vehicle</name>
  <version>0.1.0</version>
  <description>CAN interface to the safety gateway: VehicleState and GatewayStatus in, VehicleCommand out. dbc/mcqueen.dbc is the frame definition.</description>
  <maintainer email="culbertsonprime@gmail.com">Chase Culbertson</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>mcq_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
