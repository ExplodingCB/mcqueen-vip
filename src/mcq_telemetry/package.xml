<?xml version="1.0"?>
<package format="3">
  <name>mcq_telemetry</name>
  <version>0.1.0</version>
  <description>Best-effort pit telemetry, Foxglove layouts and lap timing.</description>
  <maintainer email="culbertsonprime@gmail.com">Chase Culbertson</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>mcq_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>mcq_sim</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
