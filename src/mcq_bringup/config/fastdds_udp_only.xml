<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS profile that disables the shared-memory transport so every
     participant talks over UDP loopback. Select it with
     FASTRTPS_DEFAULT_PROFILES_FILE=<this file> when a container or a slow
     subscriber makes the shared-memory segments misbehave. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_only</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="udp_only_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_only</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
